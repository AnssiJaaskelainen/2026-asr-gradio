UID=1000
GID=1000

WHISPER_THREADS=0

# OpenVINO/CTranslate2 Settings
CPU_OPTIMIZED=true
#OPENVINO_DEVICE=CPU

# Voice Activity Detection (VAD)
USE_VAD=false

# API URLs
API_URL=http://api:10001
# API_DOCS_URL=http://192.168.10.131:10001/docs

# File Upload Limits
MAX_FILE_SIZE_MB=500
MAX_BATCH_SIZE=20
MAX_ARCHIVE_FILES=100

# Docker Resource Limits
API_MEMORY_LIMIT=16g

# CORS
CORS_ORIGINS=*